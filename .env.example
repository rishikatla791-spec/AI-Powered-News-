# ── Database ───────────────────────────────────────────────
# Neon (free): use the *pooled* connection string.
# For local development without any account, leave this as the PGlite path below.
DATABASE_URL=pglite://node_modules/.cache/lede-pglite

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_EMAIL=hello@example.com
ADMIN_EMAILS=you@example.com

# ── Auth (Better Auth) ────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-32+-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend free) ───────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Lede <brief@example.com>"

# ── AI (free tiers) ───────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_DAILY_REQUEST_BUDGET=400

# ── News APIs (free keys) ─────────────────────────────────
GUARDIAN_API_KEY=
NYT_API_KEY=

# ── Rate limiting (Upstash free) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Worker ─────────────────────────────────────────────────
# Secret used by the worker to ask the site to refresh cached pages.
REVALIDATE_SECRET=replace-me
